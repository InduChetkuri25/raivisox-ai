# ─── Databases & runtime state ────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
raivisox_live.db
apps/api/raivisox_live_test.db

# ─── Task workspaces (generated pipeline output) ──────────────────────────
workspaces/
apps/api/workspaces/
apps/web/workspaces/

