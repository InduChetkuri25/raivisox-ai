[TEMPLATE]
# =============================================================================
# RAIVISOX AI Environment Configuration
# Copy this file to .env and configure for your environment.
#
# ENVIRONMENT=development (default) keeps local setup convenient.
# ENVIRONMENT=production  FAILS FAST at startup unless every required
# production value below is set explicitly (error messages name the
# variable, never the value).
# =============================================================================

# =============================================================================
# Application
# =============================================================================
APP_NAME=RAIVISOX AI API
APP_VERSION=0.1.0
DEBUG=false

# development | test | production
ENVIRONMENT=development

# =============================================================================
# Database  (REQUIRED in production — must be explicit, no default)
# =============================================================================
# Production (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://raivisox:CHANGEME@localhost:5432/raivisox
# Local development default (used when DATABASE_URL is unset):
#   postgresql+asyncpg://postgres:postgres@localhost:5432/raivisox
# SQLite works for local/dev and tests:
#   sqlite+aiosqlite:///raivisox.db
# Migrations: `alembic upgrade head` (works on PostgreSQL and SQLite);
# startup also runs an idempotent create_all.

# Async database URL (automatically derived from DATABASE_URL if not set)
DATABASE_URL_ASYNC=

# =============================================================================
# Redis (optional — reserved, not required by the current runtime)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Security  (SECRET_KEY REQUIRED in production — refused if default/short)
# =============================================================================
# Generate with: openssl rand -hex 32   (must be >= 32 chars, not a placeholder)
SECRET_KEY=dev-secret-key-change-in-production-12345

# JWT algorithm
ALGORITHM=HS256

# Access token expiration in minutes (default: 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# CORS / Hosts  (REQUIRED in production — explicit origins, no wildcard)
# =============================================================================
# Comma-separated OR JSON array — both forms are accepted.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host header allow-list (TrustedHost middleware; empty = disabled in dev,
# REQUIRED non-empty in production), e.g. api.example.com
ALLOWED_HOSTS=

# =============================================================================
# AI Provider  (REQUIRED in production: an Ollama/LM Studio endpoint or a
# provider API key — the pipeline refuses to start without one)
# =============================================================================
# OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, OpenAI, ...):
#RAIVISOX_LLM_BASE_URL=http://127.0.0.1:11434/v1
#RAIVISOX_LLM_MODEL=qwen2.5:0.5b
# Non-empty key marks any endpoint usable. Ollama ignores auth, so any
# sentinel works for local endpoints (required for non-localhost Ollama):
#RAIVISOX_LLM_API_KEY=local-ollama
# Hosted providers:
#OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...
#GOOGLE_API_KEY=...

# =============================================================================
# Execution Settings
# =============================================================================
DEFAULT_EXECUTION_MODE=BALANCED
DEFAULT_TASK_TIMEOUT=300
#MAX_EXECUTION_BUDGET=10.00

# =============================================================================
# Artifact storage limits (positive integers; enforced at registration and
# at bundle download — see docs/deployment.md)
# =============================================================================
# 50 MiB per artifact:
MAX_ARTIFACT_SIZE_BYTES=52428800
# Registry rows (including history) per task:
MAX_ARTIFACTS_PER_TASK=1000
# 200 MiB per ZIP bundle:
MAX_ZIP_SIZE_BYTES=209715200
MAX_ZIP_FILES=10000
# 0 = keep artifact bytes forever (default). With N > 0, physical bytes of
# artifacts that are superseded (no longer the task's current deliverable)
# and older than N days are deleted by the scheduled cleanup worker;
# registry METADATA is always kept — history stays queryable and downloads
# honestly report missing bytes.
ARTIFACT_RETENTION_DAYS=0
# Interval between scheduled cleanup passes, seconds (default: 6 hours).
# Only relevant when ARTIFACT_RETENTION_DAYS > 0; one worker per process,
# disabled entirely at retention 0. See docs/deployment.md.
ARTIFACT_CLEANUP_INTERVAL_SECONDS=21600

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Frontend (apps/web — see apps/web/.env.example)
# =============================================================================
# Public API base URL, baked into the client bundle at BUILD time:
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Health endpoints (no auth, no secrets/paths in responses)
#   GET /health        legacy liveness
#   GET /health/live   liveness  (process up; no dependency checks)
#   GET /health/ready  readiness (database + storage gate; LLM advisory)
# =============================================================================
